# ════════════════════════════════════════════════
# Nikon Expert — 环境配置模板
# 复制为 .env 并按需修改
# ════════════════════════════════════════════════

# ── LLM 配置 ────────────────────────────────────
LLM_BASE_URL=http://localhost:11434
# 取消注释想用的模型：
LLM_MODEL=qwen2.5:7b-instruct-q8_0
#LLM_MODEL=gemma3:4b
#LLM_MODEL=gemma3:12b
LLM_REQUEST_TIMEOUT=180

# ── 外接大脑（云端 provider，可选）──────────────
# 默认本地 Ollama（零外传）。想用云端大脑再填 key；
# 海外(Claude/GPT/Gemini)自动走本地 socks5 代理。
# ⚠️ 选云端会把"检索片段+问题"外传对应 API；embedding/检索始终本地。
LLM_PROXY=socks5h://127.0.0.1:7890
LLM_MAX_TOKENS=4096
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=

# ── Embedding 模型（本地路径）───────────────────
EMBED_MODEL_PATH=./models/bge-m3
RERANKER_MODEL_PATH=./models/bge-reranker-v2-m3

# ── 向量数据库 ───────────────────────────────────
QDRANT_PATH=./data/qdrant_db
COLLECTION_NAME=nikon_expert_v1

# ── 检索参数 ─────────────────────────────────────
RETRIEVAL_TOP_K=8
RERANK_TOP_N=4
CONFIDENCE_THRESHOLD=0.30

# ── 数据源路径 ───────────────────────────────────
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault
MANUALS_DIR=./data/raw/manuals

# ── 应用配置 ─────────────────────────────────────
UI_PORT=7860
LOG_LEVEL=INFO
